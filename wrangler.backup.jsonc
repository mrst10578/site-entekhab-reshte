{
  "name": "konkour-database-backup",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "previews": {},
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "konkour-database",
      "database_id": "a50755c7-b00b-4605-a0d0-374e54806f6f"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 0.1
    },
    "issues": {
      "enabled": true
    }
  }
}
