NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Verified on the official Mahak website; also the default when left blank.
NEXT_PUBLIC_MAHAK_DONATION_URL=https://mahak-charity.org/online-payment/

# Cloudflare Worker secret. Never prefix this with NEXT_PUBLIC and never commit a real key.
# Production: npx wrangler secret put RAMZFA_API_KEY
RAMZFA_API_KEY=cpay_live_REPLACE_ME

# Local data sync only. Point at a checkout of Entekhab-Reshte/data/raw.
# SOURCE_DATA_ROOT=../Entekhab-Reshte/data/raw
# Optional provenance marker written into generated index metadata.
# SOURCE_DATA_COMMIT=
