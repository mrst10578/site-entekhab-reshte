{
  "name": "konkour-database",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "loprax.dpdns.org",
      "custom_domain": true
    },
    {
      "pattern": "www.loprax.dpdns.org",
      "custom_domain": true
    }
  ],
  "previews": {},
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/entekhab-yar/data.json",
      "/entekhab-yar/IRANSansX.woff2"
    ]
  }
}
